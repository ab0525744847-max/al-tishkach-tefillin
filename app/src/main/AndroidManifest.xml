<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- אינטרנט -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- התראות -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- רטט -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- תזכורות ושעונים מדויקים -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- הפעלת התזכורות מחדש לאחר הפעלת הטלפון -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- אפשרות להציג התראת שעון מעורר במסך מלא -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- הצגה מעל אפליקציות אחרות -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- שירות בחזית -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- שירות בחזית עבור השמעת צלצול -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- שמירת המכשיר ער בזמן האזעקה -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:label="אל תשכח תפילין"
        android:supportsRtl="true"
        android:theme="@style/Theme.AlTishkachTefillin">

        <!-- האפליקציה הראשית -->
        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- מסך השעון המעורר -->
        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- קבלת התזכורת -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- שחזור התזכורת לאחר הפעלה מחדש -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

        </receiver>

    </application>

</manifest>
